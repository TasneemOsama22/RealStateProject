QPushButton {
    background-color: #3E3E3E; /* Darker button background */
    color: #FFFFFF; /* White button text */
}

QLineEdit {
    background-color: #3E3E3E; /* Dark background for input fields */
    color: #FFFFFF; /* White text */
    border: 1px solid #555555; /* Slight border */
}

QLabel {
    color: #FFFFFF; /* White text for labels */
}
</string>
